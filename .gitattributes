* text=auto

# Rust & config files normalized to LF
*.rs   text eol=lf
*.toml text eol=lf
*.lock text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.md   text eol=lf

# Windows scripts normalized to CRLF for cmd.exe and Windows PowerShell 5.1
*.ps1  text eol=crlf
*.cmd  text eol=crlf
*.bat  text eol=crlf
